# Names only. Copy to .env.local and fill in. Never commit .env.local.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=           # only for `npm run db:migrate` (Settings > Database > Connection string > URI). Not needed on Vercel.

# LLM for post-call extraction. Set ONE key. Brief specifies Claude; Gemini also supported.
AI_PROVIDER=           # anthropic | gemini (optional; defaults to whichever key is set)
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Vaani (voice AI)
VAANI_API_KEY=
VAANI_WEBHOOK_SECRET=   # long random string; goes in the webhook URL as ?token=
VAANI_TOOL_SECRET=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_FRONTDESK_CHAT_ID=
TELEGRAM_NIKHIL_CHAT_ID=

# Cal.com (consult booking). Free tier = one account, one shared consult calendar.
CALCOM_API_KEY=            # cal.com > Settings > Developer > API keys
CALCOM_EVENT_TYPE_ID=      # number in the URL of your "Aangan consult" event type
CALCOM_ATTENDEE_EMAIL=     # a REAL inbox the studio owns (e.g. frontdesk@yourstudio.com). Cal.com rejects fake domains; we add +caller<phone> per booking

# HubSpot (CRM sync: scope still to be confirmed, see docs/open-questions.md)
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_PORTAL_ID=

# Scheduler
CRON_SECRET=

# SMS (provider TBC; lib/sms.ts is provider-agnostic)
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER_ID=

# App
APP_BASE_URL=
